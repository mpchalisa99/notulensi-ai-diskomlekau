# GEMINI_API_KEY: Primary Gemini API key (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Automatic Gemini API Key Failover (optional additional keys, never hardcode in source):
# Option A: Comma-separated list of keys in GEMINI_API_KEYS
# GEMINI_API_KEYS="key_1,key_2,key_3"
# Option B: Numbered fallback keys GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
